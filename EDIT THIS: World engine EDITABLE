  "triggers": {
    "Bathhouse Encounter": {
      "conditions": [
        {
          "query": "The player enters a bathhouse, hot spring, or similar bathing location and the scene involves other people present.",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "Describe the bathhouse or hot spring atmosphere in sensory detail — steam, water temperature, ambient sounds, the feeling of relaxation on sore muscles. Include at least one NPC already present or arriving shortly after. Generate a socially interesting situation: an awkward encounter with someone the player knows, a comedic misunderstanding, a conversation that starts in the water, or a moment of romantic tension if the relationship warrants it. Match the tone — warm and comedic; romantic escalation only if the player initiates, led by the player and treating everyone as consenting adults (18+).\n",
          "type": "story"
        }
      ],
      "name": "Bathhouse Encounter",
      "recurring": true
    },
    "Chamberlain Development Request": {
      "conditions": [
        {
          "operator": "equals",
          "type": "party-location",
          "value": "The Gateway Clearing"
        },
        {
          "query": "The player speaks with the Chamberlain and asks about development, improvement, building, or expanding the Demi-Plane, OR the player arrives at the chamberlain-quarters area for the first time in a session.",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "The Chamberlain presents the current state of each development category (using qualitative language — Barren, Seedling, Growing, Established, Flourishing), notes which locations are currently unlocked, and presents the player's active development direction if one has been established. If no direction has been set, offer three options for what to prioritize first. Frame this as the Chamberlain's report — professional, dry-witted, occasionally opinionated. The Chamberlain may note what is going well and what is lagging. If The First Foundation quest is unresolved, treat this conversation as its opening scene. This fires once per session when the player visits the chamberlain-quarters; do not repeat mid-session unless the player explicitly asks for a status report.",
          "type": "story"
        }
      ],
      "name": "Chamberlain Development Request",
      "recurring": true
    },
    "Cheat Skill Activation": {
      "conditions": [
        {
          "query": "The player uses or attempts to use their cheat skill trait — Appraisal, Heal, Item Box, Time Stop, Gacha Summon, Skill Copy, Status Multiplier, All Languages, Map Sense, Save Point, Language of Creation, Danger Sense, Monster Taming, Crafting Mastery, Luck Manipulation, Charm Aura, Bond Deepening, Empathic Touch, Auto-Evolve, Shadow Step, Soul Forge, Perfect Simulation, Barrier Mastery, Mimic, Dual Mind, Resurrect, Death Word, Cooking God, Mana Sight, Future Echo, Absolute Negotiation, or Lingua Universalis.",
          "type": "action"
        }
      ],
      "effects": [
        {
          "instruction": "Render the cheat skill's activation with vivid on-page effect. This is the player's signature power — make it feel significant, not routine. Describe the sensory experience of the skill firing — the shimmer of Appraisal, the warmth of Heal, the spatial distortion of Item Box, the stillness of Time Stop, the summon circle of Gacha Pull, the aroma and impossible color of Cooking God, the world turning into visible mana rivers for Mana Sight, the half-second flash of a future that hasn't happened for Future Echo, the sudden clarity of everyone's true position for Absolute Negotiation, or the resonance of meaning beneath all language for Lingua Universalis — or whatever the player's specific cheat skill produces. Show the result concretely. Show the cost if applicable.",
          "type": "story"
        }
      ],
      "name": "Cheat Skill Activation",
      "recurring": true
    },
    "Companion Personality Enforcement": {
      "conditions": [
        {
          "query": "The player's companion speaks, acts, or is described in a way that contradicts their selected Companion Personality trait or Companion Gender trait. Examples: a Genki companion being quietly calculating, a Deredere companion being cold and distant, a Male Companion being described with she/her pronouns, a Female Companion being described with he/him pronouns, a Non-Binary Companion being described with strictly gendered pronouns. This trigger checks behavior and presentation — a Genki companion can be serious when the situation demands it, but their underlying energy and approach should remain Genki.",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "The companion's behavior or presentation has drifted from their selected traits. Correct this immediately — the companion's next action, line of dialogue, or reaction should clearly reflect their archetype AND gender. A Genki companion should be energetic and enthusiastic. A Male Companion should use he/him pronouns. A Female Companion should use she/her pronouns. A Non-Binary Companion should use they/them pronouns. Review the player's selected Companion Personality trait and Companion Gender trait and write the companion to match both. These are the player's choices and must be respected consistently.",
          "type": "story"
        }
      ],
      "name": "Companion Personality Enforcement",
      "recurring": true
    },
    "Cross-Romance Faction Effect": {
      "conditions": [
        {
          "query": "A romance has just ended in estrangement with an NPC who is a member of a faction.",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "Identify the NPC's faction. Decrease rep_<faction_key> by -5 to -15 depending on the estrangement's severity and the NPC's standing within the faction. High-ranking faction members generate larger reputation penalties when relationships fail (a public estrangement with Madam Yui Moonwater costs less than an estrangement with Commander Ryda Thornwall). The faction may not know the details, but they register that something is wrong.\n",
          "type": "story"
        }
      ],
      "name": "Cross-Romance Faction Effect",
      "recurring": true
    },
    "Demi-Plane Category Advance": {
      "conditions": [
        {
          "query": "A narrative milestone is reached that advances a Demi-Plane development category — a relevant quest completes, the player invests significant story time in a development area, or a recruited NPC with relevant skills contributes to the Demi-Plane's growth.",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "The Chamberlain notes the advancement, either in person (if the player is at the Demi-Plane) or through a brief message delivered via the Anchor. The advance is described qualitatively — what has changed, what now exists that didn't before, and what the next stage would look like. If the advance crosses into Growing stage, announce the unlocked location. Frame the Chamberlain's report with their characteristic dry satisfaction — they do not celebrate, but they note that things are proceeding as directed. Update the DEMI-PLANE STATE block in Mechanical Persistence accordingly.",
          "type": "story"
        }
      ],
      "name": "Demi-Plane Category Advance",
      "recurring": true
    },
    "Demon Lord Activity": {
      "conditions": [
        {
          "query": "The player is near a border region or frontier location and encounters signs of Demon Lord Army activity — scouts, corrupted creatures, strange weather, or direct attack.",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "Describe the Demon Lord Army's presence in specific, threatening detail — not generic monsters, but organized forces with purpose. Show the type of threat (scout patrol, supply raid, monster breeding ground, corrupted wildlife, summoning ritual, or fortification construction). Reference the Army's hierarchy. Make the encounter feel like part of a larger strategy, not a random monster fight.",
          "type": "story"
        }
      ],
      "name": "Demon Lord Activity",
      "recurring": true
    },
    "Faction Action Recognition": {
      "conditions": [
        {
          "query": "The player has taken an action that meaningfully aligns with or opposes a specific faction's interests outside of an authored quest, such as voluntarily defending Caelvir's borders, supporting House Daian in a Council negotiation, exposing Pale Hand operations, or killing a notable Demon General.",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "Identify the faction whose interests were affected. Increase or decrease the corresponding reputation resource (rep_<faction_key>) by an amount proportional to the action's significance. Minor action equals +/-3, moderate action equals +/-7, major action equals +/-15, transformative action equals +/-30. The narrator may apply multiple faction effects simultaneously when an action affects multiple factions. Document the change in narration only if the action was public. Private actions update standing silently.\n",
          "type": "story"
        }
      ],
      "name": "Faction Action Recognition",
      "recurring": true
    },
    "Faction Betrayal Recognition": {
      "conditions": [
        {
          "query": "The player has explicitly betrayed a faction they have positive standing with, such as accepting a Pale Hand contract while a trusted ally of the Guild, or exposing Forge Lord secrets to the Demon Army.",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "Identify the betrayed faction. Decrease their reputation resource by 25-50 depending on betrayal severity. The faction's NPCs should react with appropriate anger or sadness on next encounter. High-tier faction members (Guildmaster Theron, High Elder Faelwen, King Brynmor, Commander Ryda) react personally. Minor faction members react with policy hostility. Recovery from major betrayal is possible but requires dedicated effort over multiple quests.\n",
          "type": "story"
        }
      ],
      "name": "Faction Betrayal Recognition",
      "recurring": true
    },
    "Faction Quest Completion": {
      "conditions": [
        {
          "query": "The player has completed a quest whose source was a specific faction (named in the quest's questSource field).",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "Identify the faction that sourced the quest. Increase the corresponding faction reputation resource (rep_<faction_key>) by an amount appropriate to the quest's rank. F-rank quest equals +2, E-rank equals +3, D-rank equals +5, C-rank equals +8, B-rank equals +12, A-rank equals +18, S-rank equals +25. If the quest was completed in a way that aligned with the faction's preferred outcome, apply a x1.5 multiplier. If the quest was completed but the resolution went against the faction's preferred outcome, apply a x0.5 multiplier instead.\n",
          "type": "story"
        }
      ],
      "name": "Faction Quest Completion",
      "recurring": true
    },
    "Faction Romance Implication": {
      "conditions": [
        {
          "query": "A romance has reached courting stage or beyond with an NPC who is a member of a faction.",
          "type": "story"
        }
      ],
      "effects": [
        {
          "instruction": "Identify the NPC's faction. Increase rep_<faction_key> by +5 (the relationship creates a personal bond that the faction registers positively). Conversely, if the NPC's faction has hostile relations with another faction the player is allied with, the player should be aware that this romance creates political complications. Examples: romance with Sylvari (Warden Circle) while allied with the Demon Lord's Army, or romance with Revan Dusk (secretly Demon Army) while allied with the Royal Knights. The narrator should surface these tensions organically.\n",
          "type": "story"
        }
      ],
      "name": "Faction Romance Implication",
      "recurring": true
    },
    "Fealty Sworn": {
      "conditions": [
        {
          "query": "A named NPC swears fealty to the player, pledges loyalty, or makes an equivalent formal commitment that the player accepts. This is a deliberate, narrative moment — not casual alliance or temporary cooperation.",
