      "visitedAreas": []
    },
    "Beginning's Torii": {
      "name": "Beginning's Torii",
      "basicInfo": "A vermilion gate rising from the unmarked grass at the northwest edge of The First Meadow, marking the crossing into the Veiled Fox Sanctuary. Fox statues sit on either side the way a household sets out garden kami, and a faint smell of sugared ginger never quite fades. Beyond it the sanctuary's shape can be glimpsed — fox-spirit woodland visible from the meadow — but the gate opens for Tsukiko alone; no road continues past it for anyone else.\n\nLiving Ecology: Meadow flowers stop one respectful pace from the vermilion posts, while violetwing moths settle beneath the lintel and brighten when Tsukiko or an authorized visitor approaches. The boundary remains beautiful, visible, and absolute.",
      "x": 25,
      "y": 20,
      "radius": 2,
      "region": "The First Meadow",
      "complexityType": "simple",
      "detailType": "detailed",
      "known": true,
      "hiddenInfo": "The torii appeared the same morning the sanctuary did — a threshold installed by a mother expecting no visitors but her children. The gate reads Her will when she approaches and parts like memory in daylight; for anyone else it remains standing, swaying gently, as friendly and impassable as the horizon. Flower sprites maintain a tiny spirit shrine at its base — a few pebbles, a cobalt bloom, a fox-figurine of pressed pollen — rebuilt fresh each morning. Fox statues' bibs are always slightly damp at dawn, as if someone tends them before the meadow wakes.\n\nEcological Continuity: The Torii reads current permission through Tsukiko's established sanctuary authority. It does not infer moral worth, expose secrets, or convert desire to enter into authorization.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
