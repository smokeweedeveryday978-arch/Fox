  "arcs": {
    "arrival": {
      "id": "arrival",
      "title": "Arrival",
      "theme": "You are not from here, and everyone can tell.",
      "surfacePremise": "You woke up in Aerfála. You have a cheat skill you do not understand, no money, no papers, and no idea which way is south.",
      "expectedConclusion": "A Guild card, a rank, and a reason to be in this world beyond the accident that put you here.",
      "secrets": [
        "The Seekers of the Return register every known arrival. You are already a documented subject and nobody asked you.",
        "Your cheat skill is not as unique as you have been told."
      ],
      "minQuestsForConclusion": 0,
      "status": "dormant",
      "escalationLevel": 0,
      "creationTick": -1,
      "lastUpdateTick": 146
    },
    "the_climb": {
      "id": "the_climb",
      "title": "The Climb",
      "theme": "F to S, and the difference between D and B is mostly whether you came home.",
      "surfacePremise": "Guild work. Contracts, parties, ranks, and the slow business of becoming someone people have heard of.",
      "expectedConclusion": "A name that opens doors — and jobs that will kill you.",
      "secrets": [
        "Reputation with one faction is a debt to another. You cannot serve everyone.",
        "The Pale Hand has been watching your rank climb with interest."
      ],
      "minQuestsForConclusion": 0,
      "status": "dormant",
      "escalationLevel": 0,
      "creationTick": -1
    },
    "the_breaches": {
      "id": "the_breaches",
      "title": "The Breaches",
      "theme": "Something is opening the seals, and it is not the Demon Lord.",
      "surfacePremise": "Demonic breaches are appearing where the Warden Circle says they cannot. The Circle is stretched thin and is not telling anyone why.",
      "expectedConclusion": "The player learns who is opening them, and what they want.",
      "secrets": [
        "The Demon Lord's Army is not behind this and is as alarmed as anyone.",
        "Somebody with a legitimate seal is using it."
      ],
      "minQuestsForConclusion": 0,
      "status": "dormant",
      "escalationLevel": 0,
      "creationTick": -1
    },
    "the_courts": {
      "id": "the_courts",
      "title": "The Courts",
      "theme": "Solasreach's knights, Dúnbheal's forges, Muirscáth's coin — and none of them can stand alone.",
      "surfacePremise": "The great powers of Aerfála are each convinced the others are the problem, and the player is now useful enough to be courted by all of them.",
      "expectedConclusion": "An alliance, a betrayal, or a player who managed to belong to nobody.",
      "secrets": [
        "Each faction is doing something decent and something unforgivable with the same hands.",
        "Somebody is financing both sides of the Fálgarr dispute."
      ],
      "minQuestsForConclusion": 0,
      "status": "dormant",
      "escalationLevel": 0,
      "creationTick": -1
    },
    "the_return": {
      "id": "the_return",
      "title": "The Return",
      "theme": "There is a way home. That is not the same as wanting to take it.",
      "surfacePremise": "The Seekers of the Return have been working on the crossing for generations. They think you might be the key. They are being very careful about how they say so.",
      "expectedConclusion": "The player finds the way home — and decides.",
      "secrets": [
        "Going back may not be reversible.",
        "Somebody in this world would be destroyed if you left, and has not said so."
      ],
      "minQuestsForConclusion": 0,
      "status": "dormant",
      "escalationLevel": 0,
      "creationTick": -1
    },
    "the_descent": {
      "id": "the_descent",
      "title": "The Descent",
      "theme": "Power is a door that only opens inward, and every step through it costs someone who trusted you.",
      "surfacePremise": "Nobody is strong enough to stop the player from simply taking this world — nobody but the person they have been so far. The offer is always open, from the Demon Lord's recruiters, the Pale Hand, and the quiet voice that says you have earned this.",
      "expectedConclusion": "The player becomes a power Aerfála must reckon with on its own terms — a dark sovereign, a Demon Lord's peer, or something with no name yet.",
      "secrets": [
        "The people who were afraid of you were right.",
        "There is no bottom to this. There is only how far you decide to go, and who you let watch you do it."
      ],
      "minQuestsForConclusion": 0,
      "status": "dormant",
      "escalationLevel": 0,
      "creationTick": -1
    },
    "the_reckoning": {
      "id": "the_reckoning",
      "title": "The Reckoning",
      "theme": "The thing that ended the last world did not die. It waited for someone worth ending.",
      "surfacePremise": "The breaches, the Demon Lord's long silence, the dying of a goddess, the drowned temples — pulled far enough, every thread the player has touched runs back to a single old wound, and it is reopening.",
      "expectedConclusion": "At the mythic ceiling, the player faces the cause of the Catastrophe itself — and the world turns on what they choose to do about a thing that cannot be killed, only refused.",
      "secrets": [
        "The Seekers' return-gate and the Catastrophe are the same lost Pre-Collapse art, aimed two different ways.",
        "It was not defeated two thousand years ago. It was talked out of it. That option is still on the table, and so is the other one."
      ],
      "minQuestsForConclusion": 0,
      "status": "dormant",
      "escalationLevel": 0,
      "creationTick": -1
    },
    "arc_148_1789969186761": {
      "id": "arc_148_1789969186761",
      "theme": "The desperate defense of the Ashen Steppe against an escalating demonic offensive.",
      "surfacePremise": "A demon war-horn is sounding from the ridge, signaling a hungry and superior force approaching the weakened garrison.",
      "title": "The Horns of the Steppe",
      "expectedConclusion": "The garrison's position is secured or the demonic war-band is decisively defeated.",
      "status": "dormant",
      "escalationLevel": 1,
      "creationTick": 148,
      "minQuestsForConclusion": 4,
      "secrets": [
        "The sounding horn belongs to the 'Herald of Ash,' a low-ranking but ambitious demon officer seeking a promotion by clearing this specific outpost.",
        "The human garrison hasn't received a supply shipment in three weeks because the main road through the Ashen Steppe has been silently swallowed by a miasma-induced sinkhole.",
        "Sergeant Hadrian Pike is carrying a sealed command that orders the immediate abandonment of this post, but he has refused to open it to maintain his men's morale.",
        "The demon skirmishers are intentionally targeting the fort's foundation stones, which are actually ancient warding anchors that keep the local miasma from becoming lethal to humans.",
        "The 'miracle' of Tsukiko's arrival was not random; the gate she used was briefly stabilized by a surge of mana from a dormant, subterranean structure beneath the ramparts.",
        "A spy within the human military command leaked the garrison's patrol schedules to the Demon Lord’s Army in exchange for safe passage for their family.",
        "The Herald of Ash is under orders from a General in the Obsidian Citadel to recover a specific relic buried beneath the Ruined Ford, not just to kill the soldiers.",
        "The miasma vents in the nearby Sulfur Flats are pulsing in sync with the demon horns, suggesting the demons are using the land's own energy to signal their movements.",
        "The Ruined Ford's waters are turning black not from mud, but from concentrated essence intended to 'poison' the land for a future demonic ritual.",
        "The true objective of this offensive is to draw out a 'Peer-Tier' defender, as the Obsidian Citadel seeks to test the strength of the frontier's newest anomalies."
      ],
      "lastUpdateTick": 156
    },
    "arc_198_1790013004342": {
      "id": "arc_198_1790013004342",
      "theme": "A challenge of wits and ideology issued by a Demon Lord to a mortal who refuses to show their hand.",
      "surfacePremise": "The Ashen Empress has taken a personal interest in testing your system against the intellectual and magical elite of her realm.",
      "title": "The Empress's Intoxicating Game",
      "expectedConclusion": "The player either proves their 'system' superior to the abyss's finest minds or earns the Empress's genuine respect/enmity through their performance.",
      "status": "active",
      "escalationLevel": 0,
      "creationTick": 198,
      "minQuestsForConclusion": 5,
      "secrets": [
        "The Abyssal Testing Grounds are powered by a mana-siphon that reacts specifically to the 'certainty' of a mind, fluctuating based on the subject's willpower.",
        "Several minor demon nobles have placed heavy wagers on the player's failure, creating a hidden network of spectators eager to see the 'system' broken.",
        "The trials are designed to escalate only when a subject successfully hides a secret, as the arena craves undisclosed information to stabilize its geometry.",
        "Lilessa herself created these grounds centuries ago to find an advisor who could perceive the flaws in her own 'perfect' logic.",
        "A previous mortal challenger left behind a mental resonance in the arena that functions as a 'ghost' of their failed logic, which may manifest as a distraction.",
        "The Empress's primary goal isn't to kill the player, but to use the trials to map the unique 'rules' of the player's system for her own strategic use against other Demon Lords.",
        "The central pedestal of the testing grounds is actually a dormant gateway to a deeper layer of the abyss that opens only when someone speaks a truth the Empress does not already know.",
        "Winning the trial confers a 'Mark of the Intoxicant,' which grants social status in the Virtue Court but makes the bearer a permanent target for those seeking to usurp that prestige.",
        "The final trial culminates in the 'Mirror of Sins,' where the player must face a literal manifestation of their own system's most contradictory rule.",
        "Lilessa's ultimate secret is that she is losing her own grip on the Virtue Court's 'Sovereignty,' and she hopes the player's outsider system provides a way to redefine her rule."
      ]
    }
  },
  "narrativeEvents": {
    "the_arrival": {
      "title": "The Crossing",
      "targetTurns": 3,
      "beats": "One moment: a road, a room, a truck, a stairwell, a very ordinary Tuesday. The next: sky the wrong colour, air that smells of nothing you have a word for, and grass that is not quite grass.\n\nNo fanfare. No welcoming committee. No tutorial. You are lying in a field and you are alone and the sun is going down.\n\nDo NOT open with the cheat skill. Open with the cold, and the hunger, and the total absence of anyone who cares.",
      "onCompleteEffects": [
        {
          "type": "story",
          "instruction": "They are here. They have nothing. The nearest settlement is a day's walk and they do not know which way it is."
        },
        {
          "type": "write-boolean",
          "key": "has_arrived",
          "operator": "set",
          "value": true
        }
      ],
      "status": "completed",
      "turnsActive": 0,
      "id": "the_arrival",
      "startingLocation": "Wilderness",
      "completedTick": 19
    },
    "the_first_kill": {
      "title": "The First One",
      "targetTurns": 2,
      "beats": "It is not heroic and it is not clean and it takes far longer than they expect.\n\nAfterwards their hands will not stop. Somebody experienced will say something kind and slightly rote, because they have said it before, to somebody else, who is now dead.",
      "onCompleteEffects": [
        {
          "type": "story",
          "instruction": "Something in them has moved. Do not make it noble. This world does not do noble — it does survived."
        }
      ],
      "status": "inactive",
      "turnsActive": 0,
      "id": "the_first_kill"
    },
    "the_guild_card": {
      "title": "The Card",
      "targetTurns": 2,
      "beats": "Name. Race. Class. Rank. Party.\n\nThe receptionist has done this ten thousand times and stamps it without looking up. It is the least ceremonial moment of the player's life and it is the one that makes them real in this world.",
      "onCompleteEffects": [
        {
          "type": "story",
          "instruction": "They exist now, officially, in a way they did not this morning. It changes almost nothing and it changes everything."
        },
        {
          "type": "write-boolean",
          "key": "is_registered",
          "operator": "set",
          "value": true
        }
      ],
      "status": "inactive",
      "turnsActive": 0,
      "id": "the_guild_card"
    },
    "the_breach": {
      "title": "A Breach Where There Should Not Be One",
      "targetTurns": 4,
      "beats": "The air tears. Not dramatically — quietly, like fabric, and something the wrong shape comes out of it.\n\nThe Warden Circle says this cannot happen here. The Warden Circle has said that about the last four.",
      "onCompleteEffects": [
        {
          "type": "story",
          "instruction": "The Circle is stretched thin and is not telling anyone why. Whoever is opening these has a legitimate seal, and that narrows the list considerably."
        },
        {
          "type": "write-boolean",
          "key": "saw_a_breach",
          "operator": "set",
          "value": true
        }
      ],
      "status": "inactive",
      "turnsActive": 0,
      "id": "the_breach"
    },
    "the_offer_home": {
      "title": "The Way Back",
      "targetTurns": 4,
      "beats": "The Seekers have been working on the crossing for generations. They have never had someone like the player before, and they are being extremely careful about how they say so.\n\nThere is a way home. It might work. It might not be reversible.\n\nAnd somebody in this world would be destroyed if the player took it, and has not said so, and is not going to.",
      "onCompleteEffects": [
        {
          "type": "story",
          "instruction": "Do NOT resolve this for them. Do not have anyone beg. The person who would be destroyed says nothing at all, and that silence should be the loudest thing in the scene."
        },
        {
          "type": "write-boolean",
          "key": "the_way_home_found",
          "operator": "set",
          "value": true
        }
      ],
      "status": "inactive",
      "turnsActive": 0,
      "id": "the_offer_home"
    },
    "the_road_back": {
      "title": "The Road Back Runs Beneath the Capital",
      "targetTurns": 4,
      "beats": "It is real. Under the capital, behind three seals and a lie the Seekers have kept for generations, the way back to Earth waits — and it works both ways.\n\nNobody tells you the rest until you are standing in front of it: your power will cross with you, the world you left did not pause while you were gone, and at least one person who came here before you chose never to go back.",
      "onCompleteEffects": [
        {
          "type": "story",
          "instruction": "The means of return is confirmed and its location known. The choice is now the player's to make on their own timeline — and someone close to them would be quietly devastated by it."
        },
        {
          "type": "write-boolean",
          "key": "found_way_home",
          "operator": "set",
          "value": true
        }
      ],
      "status": "inactive",
      "turnsActive": 0,
      "id": "the_road_back"
    },
    "the_companion_secret": {
      "title": "What a Companion Was Hiding",
      "targetTurns": 4,
      "beats": "It comes out at the worst possible moment, the way these things do — mid-fight, mid-flight, or in the one quiet hour you thought you'd earned. A companion you trusted has been carrying something: a name that isn't theirs, a past that isn't finished, a self they never let you see.\n\nHow you answer it decides what the two of you are to each other from here.",
      "onCompleteEffects": [
        {
          "type": "story",
          "instruction": "A companion's concealed truth is now in the open and the relationship has reached a real turning point — it can deepen into commitment, fracture, or transform, shaped by how the player responds."
        },
        {
          "type": "write-boolean",
          "key": "companion_truth_out",
          "operator": "set",
          "value": true
        }
      ],
      "status": "completed",
      "turnsActive": 1,
      "id": "the_companion_secret",
      "startingLocation": "Drifthollow",
      "completedTick": 83
    },
    "the_rigged_trial": {
      "title": "The Trial That Was Never Fair",
      "targetTurns": 4,
      "beats": "The promotion trial is exactly as hard as it needs to be to stop you — no harder, and no more honest. Somewhere above the rank you're clawing toward, someone decided who gets to rise, and it was never going to be an outworlder.\n\nThe rival matching you rank for rank isn't playing clean either. The difference is they always knew the game was crooked.",
      "onCompleteEffects": [
        {
          "type": "story",
          "instruction": "The player has learned the Guild's upper trials are quietly rigged and that a ruthless rival is climbing by any means. Reaching the top ranks is now a question of how, not just whether."
        },
        {
          "type": "write-boolean",
          "key": "knows_guild_rigged",
          "operator": "set",
          "value": true
        }
      ],
      "status": "inactive",
