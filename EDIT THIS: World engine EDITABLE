  "factions": {
    "Forge Lords": {
      "factionType": "minor",
      "name": "Forge Lords",
      "basicInfo": "The aristocratic craft-guilds that govern Dúnbheal's economy and much of its politics. Each Forge Lord controls a sector — weapons, armor, tools, jewelry, enchanted goods — and holds their position through mastery of their craft and the loyalty of their apprentices. The Forge Lords' Council debates policy in Ironhold's Chamber of Anvils, where tradition dictates that any decision must be unanimous or resolved by a forging contest. They are stubborn, proud, and produce the finest metalwork on the continent.",
      "hiddenInfo": "The Forge Lords are sitting on a cache of pre-Collapse magitech — ancient blueprints for constructs and weapons that could reshape warfare. They are divided on whether to use, sell, or destroy them.",
      "known": false,
      "detailType": "detailed"
    },
    "The Pale Hand": {
      "factionType": "minor",
      "name": "The Pale Hand",
      "basicInfo": "A continent-spanning network of assassins, spies, and information brokers. No public headquarters, no declared membership, no uniform — just a pale handprint left at the scene of confirmed kills. The Hand takes contracts from anyone who can pay, from jilted nobles to desperate merchants to kingdoms conducting deniable operations. They are professional, expensive, and reliable. Their code forbids targeting children and prohibits betraying a client to a counter-client. Everything else is negotiable.",
      "hiddenInfo": "The Pale Hand's inner circle knows that their founder is still alive — an undead lich who uses the organization as a sensor network for rare magical signatures across the continent. The contracts are partially a way to keep agents everywhere, watching everything.",
      "known": false,
      "detailType": "detailed"
    },
    "Warden Circle": {
      "factionType": "minor",
      "name": "Warden Circle",
      "basicInfo": "The elven wardens who protect Caelvir's borders and maintain the forest's ancient pacts. Part military, part priesthood, part ecological stewardship. Wardens patrol the tree line, intercept poachers, and negotiate with — or eliminate — threats to the forest's deeper sanctuaries. They answer to the Circle of Elders, not to any single leader. Outsiders find them beautiful, unnerving, and unhelpful in roughly equal measure. A Warden's oath binds them to the forest's health above any political consideration.",
      "hiddenInfo": "The Wardens have sealed three breaches from the Demon Lord's domain that opened inside Caelvir's territory in the last decade. Each breach required a sacrifice the Circle has not disclosed.",
      "known": false,
      "detailType": "detailed"
    },
    "Demon Lord's Army": {
      "factionType": "major",
      "name": "Demon Lord's Army",
      "basicInfo": "The existential threat looming beyond the frontier. Commanded by the Demon Lord — a figure whose true name, face, and even gender shift depending on who is telling the story — the Army ranges from mindless monsters to disciplined demon generals with their own honor codes. Border skirmishes are constant; full-scale invasions come in waves separated by years of uneasy quiet. The Army's leadership is feudal and fractious — generals scheme against each other as much as against the mortal kingdoms. Deserters and defectors occasionally reach civilized lands with useful intelligence and dangerous grudges.",
      "hiddenInfo": "The Demon Lord has not attacked in force for twelve years. This is not peacetime — it is preparation. The current silence is a siege by other means: destabilizing supply lines, subverting border lords, breeding dungeon monsters that surface inside kingdom territory.",
      "known": true,
      "detailType": "detailed"
    },
    "Adventurers' Guild": {
      "factionType": "major",
      "name": "Adventurers' Guild",
      "basicInfo": "The backbone of Aerfála's adventuring economy. Every major settlement hosts a branch office with a quest board, registration counter, and a receptionist who knows every rank from F to S. The Guild operates independently of any kingdom — its authority comes from the simple fact that without adventurers, the monsters win. Guild ranks determine quest access, pay rates, and party formation rules. Solo F-ranks take rat-catching jobs; S-rank parties get demon-slaying commissions. The Guild also maintains emergency communication between branches via relay magic, making it the fastest information network on the continent.",
      "hiddenInfo": "The Guildmaster of the Ríocht headquarters holds a private agreement with the Demon Lord's former general — a non-aggression pact that neither side discusses publicly. The Guild knows more about the Demon Lord's movements than any kingdom.",
      "known": false,
      "detailType": "detailed"
    },
    "Seekers of the Return": {
      "factionType": "minor",
      "name": "Seekers of the Return",
      "basicInfo": "A loosely organized fellowship of scholars, mages, and displaced persons who study the phenomenon of otherworldly arrival — the isekai events that periodically bring people from other worlds into Aerfála. The Seekers document each known arrival, interview willing survivors, and search for patterns that might reveal how to send someone back — or bring someone else through. They are tolerated by the Guild, ignored by most kingdoms, and quietly monitored by the Pale Hand. Their headquarters is a tower in Ríocht, but their true library is a pocket dimension accessible only to members.",
      "hiddenInfo": "The Seekers have successfully opened a small, unstable portal to another world — and something came through before they could close it. They do not know what. They have not told anyone.",
      "known": false,
      "detailType": "detailed"
    },
    "Royal Knights of Solasreach": {
      "factionType": "major",
      "name": "Royal Knights of Solasreach",
      "basicInfo": "The military arm of the Kingdom of Solasreach, headquartered in Dawnkeep. The Royal Knights combine heavy cavalry tradition with holy-adjacent enchantments — their blades gleam with reinforcement magic, their armor shrugs off common spells. Knights are drawn from noble families, decorated commoners, and the occasional adventurer who impressed the wrong general at the right time. They patrol the kingdom's roads, man the border fortresses, and represent the Crown at official functions. Their rivalry with the Adventurers' Guild is professional but real: knights handle wars, adventurers handle monsters, and neither likes stepping on the other's jurisdiction.",
      "hiddenInfo": "The Order's Grand Commander is dying of a curse she has kept secret for three years. When she falls, the succession will split the knights into at least two factions — those loyal to the Crown, and those loyal to the Church of the Sacred Flame.",
      "known": false,
      "detailType": "detailed"
    },
    "Merchant Houses of Muirscáth": {
      "factionType": "major",
      "name": "Merchant Houses of Muirscáth",
      "basicInfo": "The trade confederation that runs Muirscáth's Free Cities — and, by extension, a shocking amount of the continent's economy. Five Great Houses control shipping, banking, rare materials, luxury goods, and information. They compete as viciously as any kingdom at war, but unite instantly against external threats to their profits. Their caravans reach every settlement on the map; their ships dominate the southern sea lanes. The Houses are multiracial by charter: humans, elves, dwarves, beastkin, and more serve alongside each other — profit does not care about ears. Their private security forces rival small kingdoms' armies.",
      "hiddenInfo": "House Siaral is quietly bankrolling the Demon Lord's Army's border proxies in exchange for exclusive mining rights in the contested territories. The other Houses suspect but cannot prove it.",
      "known": false,
      "detailType": "detailed"
    },
    "The Clans of the Sunmane": {
      "factionType": "major",
      "name": "The Clans of the Sunmane",
      "known": true,
      "basicInfo": "The clan-confederation of the beastkin peoples of the Sunmane Steppe — dozens of clans (the Sunmane lions, the Painted-Claw hunters, the Kithwood foxes and birds, the Emberhunt wolves, and more) bound not by a ruler but by the great Moot, where the High Moot-Speaker keeps a peace made of hunt-right, guest-right, and hard-won compromise. The Clans field superb scouts, trackers, and pack-fighters, trade hides, amber, and rare beasts, and guard their homeland's borders with a wariness earned across centuries of being underestimated.",
      "hiddenInfo": "The confederation is one bad season from fracture — isolationists, integrationists, and a slavery-reckoning faction all pulling at the Moot. The High Moot-Speaker knows a single outside insult, or a single inside betrayal, could turn the clans on each other or on the kingdoms.",
      "detailType": "detailed"
    },
    "The Delvers' Guild": {
      "factionType": "major",
      "name": "The Delvers' Guild",
      "known": true,
      "basicInfo": "The independent guild that governs the Descent at Deepgate — separate from the surface Adventurers' Guild, with its own ranks, its own floor-clearances, and its own iron rules. The Delvers' Guild registers every diver, licenses parties by proven depth, taxes the spoils, runs the only sanctioned map of the upper floors, and maintains the safe-rests that keep the deep dive survivable. Its authority is absolute below the Rim: break Guild law in the labyrinth and you are simply not pulled out. It is a repeatable source of paying work — floor-clearances, retrieval, escort, and monster-cull contracts scaled to a delver's licensed depth.",
      "hiddenInfo": "The Guild's inner circle knows the labyrinth is Pre-Collapse and deepening, and rations that truth carefully. The Guildmaster is quietly recruiting the strongest delvers not for profit but to reach — and understand — the floor that is a door, before it opens on its own.",
      "detailType": "detailed"
    }
  },
