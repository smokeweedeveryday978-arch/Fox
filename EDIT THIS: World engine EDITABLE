        }
      ],
      "category": "Accessory",
      "description": "A weatherworn warden's cloak with a mail-lined collar and reinforced shoulders -- warmth, a little armor, and the quiet authority of the border watch. Price: 3-8 sp.",
      "name": "Reinforced Warden's Cloak"
    },
    "Copper Coin": {
      "name": "Copper Coin",
      "category": "Currency",
      "description": "The base currency of Aerfala. 100 cp = 1 sp. Used for daily life: food, drink, inn stays, tolls, small purchases. Most adventurers carry copper as their everyday spending money.",
      "bonuses": []
    },
    "Silver Coin": {
      "name": "Silver Coin",
      "category": "Currency",
      "description": "100 cp = 1 sp. 100 sp = 1 gp. The working currency of adventurers and soldiers. Used for weapons, armor, potions, wages, travel. Most adventuring transactions happen in silver.",
      "bonuses": []
    },
    "Gold Coin": {
      "name": "Gold Coin",
      "category": "Currency",
      "description": "100 sp = 1 gp. 10,000 cp = 1 gp. The currency of property, enchanted gear, mercenary contracts, and high-rank bounties. Gold appears at rank A+ among merchants and nobles. Most adventurers rarely see gold.",
      "bonuses": []
    },
    "Foxglow Cap": {
      "bonuses": [],
      "category": "Material",
      "description": "A pearl-stemmed mushroom whose indigo cap carries nine faint points of foxfire and whose glassy gills brighten when the sanctuary's mycelial current passes beneath it. Cut flesh pulses like a tiny sleeping heartbeat; cooked, it tastes of cedar smoke and sweet chestnut, while a raw cap produces one night of vivid but non-prophetic dreams. Alchemists use it to stabilize restorative mixtures and to give safe light to living terrariums. Price: 5-15 cp.",
      "name": "Foxglow Cap"
    },
    "Lantern-Tree Sap": {
      "bonuses": [],
      "category": "Material",
      "description": "Warm amber resin drawn only from a lantern tree's naturally opened seams. In a vial it separates into fine violet-gold ribbons that curl toward nearby living roots; brushed onto wood, paper, or stone, it forms a luminous lacquer that neither burns nor smokes and fades slowly over several days. Sanctuary artisans prize it because new coats bond cleanly to old ones without trapping rot beneath. Price: 10-25 cp.",
      "name": "Lantern-Tree Sap"
    },
    "Moonlace Bloom": {
      "bonuses": [],
      "category": "Consumable",
      "description": "A silver-blue meadow flower whose petals appear stitched together by threads of dew visible only in moonlight or rain. Steeped whole, it produces a cool floral tea that steadies trembling, softens ordinary fear, and settles restless sleep without changing judgment or erasing emotion; once spent, every luminous thread unravels into ordinary water. The best blossoms are gathered after duskbees finish pollinating them. Price: 15-40 cp.",
      "name": "Moonlace Bloom"
    },
    "Glowmoss Stone": {
      "bonuses": [],
      "category": "Material",
      "description": "A smooth marsh pebble enclosed over nine dusks by layer after layer of luminous moss until plant and mineral become one cool, green-blue stone. It drinks daylight, foxfire, or spell-glow and releases that light evenly through the night; carved pieces retain a dim reserve even after years of use. Low Reaches keepers use uncut stones to mark stable footing without disturbing the wetland's darkness. Price: 20-50 cp.",
      "name": "Glowmoss Stone"
    },
    "Foxfire Dew Bead": {
      "bonuses": [],
      "category": "Material",
      "description": "A dawn drop from Westreach grass crystallized around a mote of harmless foxfire. Each bead contains a tiny violet spiral and hums when strung beside others; cracking one releases several minutes of soft light and a scent of wet clover before the shell evaporates completely. Strings are used as trail markers, festival jewelry, and one-use signals that leave no glass behind. Price: 5-12 cp each, usually sold in strings of ten (50-120 cp).",
      "name": "Foxfire Dew Bead"
    },
    "Spirit Pollen": {
      "bonuses": [],
      "category": "Material",
      "description": "Fine luminous pollen swept from the First Meadow only after its warm-snow fall has finished. Loosed into still air, the grains drift toward active magical residue and briefly outline a spell's physical wake, ward boundary, or recently used enchanted object without identifying its caster or revealing hidden history. Spent grains turn charcoal-grey and enrich ordinary garden soil. Price: 25-60 cp per pouch.",
      "name": "Spirit Pollen"
    },
    "Blueheart Ridge Chip": {
      "bonuses": [],
      "category": "Material",
      "description": "A dark Rift March stone split by one cold cobalt vein, as though a piece of midnight retained a single pulse. The vein brightens in response to nearby magical or physical vibration—not private emotion—and can be tuned into a quiet lamp, fault alarm, or resonance marker. Fresh chips smell faintly of rain on iron and stay cold even inside a forge. Price: 30-80 cp.",
      "name": "Blueheart Ridge Chip"
    },
    "Stillmoss Peat": {
      "bonuses": [],
      "category": "Material",
      "description": "A dense brick cut from dead growth beneath the Dim March's living moss, cured until it becomes lighter than dry wood. It burns with a steady pearl flame that gives light without heat, scent, smoke, or crackle, making it ideal for vigils, precision work, and chambers where ordinary fire would disturb stored materials. Ash from a finished brick is inert and welcomed back by the moss. Price: 10-20 cp per brick.",
      "name": "Stillmoss Peat"
    },
    "Saltgrass Chime": {
      "bonuses": [],
      "category": "Material",
      "description": "A hollow white seed-node harvested after Quiet Shore saltgrass rings its one natural note. Touched again, it answers with a softer version of the first sound it heard, then falls silent forever; a strand therefore records a brief sequence of disturbances without naming what caused them. Moonplovers line their nests with spent nodes, and careful collectors always leave enough for the next grass generation. Price: 15-35 cp. A full strand (twelve grains): 1-2 sp.",
      "name": "Saltgrass Chime"
    },
    "Frost Foxfire Jar": {
      "bonuses": [],
      "category": "Material",
      "description": "Blue-white foxfire shed from Still Frontier branches during a violet thaw and sealed inside a frostwood-lidded jar. It radiates clear cold light, refuses ordinary heat, and keeps delicate reagents cool for a season; opening the jar releases it as a slow spiral that settles on the nearest frostpine rather than burning anything. Harvesters collect only motes already leaving the tree. Price: 50-90 cp per sealed jar.",
      "name": "Frost Foxfire Jar"
    },
    "Preservation Moss": {
      "bonuses": [],
      "category": "Material",
      "description": "Velvet-grey living moss lifted in intact sheets from Dim March nursery beds. Wrapped around food, herbs, monster materials, or fragile reagents, it slows ordinary decay while allowing dangerous magical pressure to bleed away into harmless pale specks. The moss must be aired and returned to damp soil between uses or it becomes inert rather than infinitely reusable. Price: 15-40 cp per bundle.",
      "name": "Preservation Moss"
    },
    "Muted Spirit-Stone": {
      "bonuses": [],
      "category": "Material",
      "description": "A river-smooth nodule grown where Dim March moss compacts spent magical vibration into mineral. It absorbs weak sound and enchantment tremor, warming by a fraction as it fills; left overnight in living stillmoss, it empties safely. Builders set small pieces into quiet rooms and containment boxes, but a single stone cannot silence combat, speech, or powerful magic. Price: 40-80 cp.",
      "name": "Muted Spirit-Stone"
    },
    "Silence-Thread Fungus": {
      "bonuses": [],
      "category": "Material",
      "description": "A pale filament fungus found as webbing beneath deep Dim March moss, each strand faintly iridescent when held against foxfire. Spun into cord or cloth, it dampens rustle, scrape, and transmitted vibration without erasing sound entirely. The fibers lose their effect if scorched and regain flexibility after a night in cool mist. Price: 25-60 cp per bundle.",
      "name": "Silence-Thread Fungus"
    },
    "Anchor-Stone": {
      "bonuses": [],
      "category": "Material",
      "description": "Dense grey stone grown along the Grey Boundary's buried braces, flecked with wine-red mineral where anchor beetles have worked it. It resists unwanted magical displacement and lends stability to portals, wards, foundations, and long-lived enchantments; worked pieces become heavier when someone attempts to teleport them. Only naturally loosened blocks are safe to quarry without weakening the moor. Price: 1-3 gp.",
      "name": "Anchor-Stone"
    },
    "Fog Crystal": {
      "bonuses": [],
      "category": "Material",
      "description": "A translucent crystal formed when Grey Boundary fog freezes around a thread of boundary moss. Mana drawn across its surface releases cold, opaque mist in proportion to the energy supplied; when the flow ends, the mist returns to the crystal as clear droplets. It is useful for concealment and humidity control, not for creating endless fog. Price: 5-12 sp.",
      "name": "Fog Crystal"
    },
    "Boundary Moss": {
      "bonuses": [],
      "category": "Material",
      "description": "Silver-grey moss whose curled tips all lean toward the nearest active spatial distortion. A transplanted patch remains responsive for several weeks if kept damp with native fog, making it a practical but imprecise planar alarm. It indicates direction and strain only—it cannot identify a traveler, destination, or cause. Price: 30-70 cp.",
      "name": "Boundary Moss"
    },
    "Condensed Dimensional Mist": {
      "bonuses": [],
      "category": "Material",
      "description": "Raw Grey Boundary vapor sealed inside a reinforced crystal ampoule, swirling around an empty center that never touches the glass. A measured drop lets spatial alchemists soften a seam, test a portal lattice, or make a small distance briefly elastic; careless release causes nearby steps and reaches to disagree until the mist disperses. It never opens the Demi-Plane without its established Gate or Anchor. Price: 8-20 sp.",
      "name": "Condensed Dimensional Mist"
    },
    "Horizon Grass": {
      "bonuses": [],
      "category": "Material",
      "description": "Long gold-green blades from the Open Horizon whose tips bend toward the clearest unobstructed route. Dried into a fan or bundle, they continue indicating passable open ground until they crumble, making them valuable to navigators in fog, tall grass, and ruins. They do not locate a person, secret, or destination—only the least obstructed direction. Price: 10-25 cp.",
      "name": "Horizon Grass"
    },
    "Windseed": {
      "bonuses": [],
      "category": "Material",
      "description": "A pearl-light seed bearing a translucent spiral vane. Even a breath can carry it across a room, while deliberate mana sends a whole pouch riding one chosen gust before the seeds root or lose their glow. Alchemists use ground vane-shell in mobility draughts; farmers use living seed to reveal prevailing currents before planting. Price: 20-50 cp per pouch.",
      "name": "Windseed"
    },
    "Ambient Mana Crystal": {
      "bonuses": [],
      "category": "Material",
      "description": "A naturally grown crystal containing diffuse ecological mana in slow-moving bands rather than a potion's concentrated restorative charge. It powers small lamps, tools, wards, and workshop devices steadily, then becomes clear inert quartz until left in a healthy mana current to recharge. Drawing it dry too quickly cracks its inner bands and ruins the cycle. Price: 1-3 sp.",
      "name": "Ambient Mana Crystal"
    },
    "Fadeglass": {
      "bonuses": [],
      "category": "Material",
      "description": "A thin plate formed where two versions of a Fade hillside briefly overlap and solidify. Its center remains visible while its rim disappears when viewed indirectly, making it superb for subtle inlay, illusion frames, and concealed but physical seams. Looking through it blurs edges and distance; it does not reveal invisible people or hidden truths. Price: 5-12 sp.",
      "name": "Fadeglass"
    },
    "Mist Pearl": {
      "bonuses": [],
      "category": "Material",
      "description": "A cool opalescent pearl grown where boundary mist repeatedly condenses around one transparent seed husk. It is always faintly damp and releases a palm-sized halo of pearly vapor when warmed, then slowly reabsorbs it. Water, illusion, and spatial alchemists prize the pearl's stable rhythm. Price: 3-8 sp.",
      "name": "Mist Pearl"
    },
    "Soundless Stone": {
      "bonuses": [],
      "category": "Material",
      "description": "Charcoal-grey stone from the solid side of the Fade, veined with transparent mineral. It produces no audible noise when struck, dropped, cut, or broken because vibration passes into the clear veins and leaves as a brief chill. It is used for precision tools and quiet construction, but it does not silence whatever touches or stands near it. Price: 4-10 sp.",
      "name": "Soundless Stone"
    },
    "Nullstone": {
      "bonuses": [],
      "category": "Material",
      "description": "Rare matte stone shed in thin slabs near the Last Edge, where weak enchantments gutter against its surface like candlelight in rain. It suppresses minor magic in direct contact and helps line containment tools; stronger effects overwhelm it rather than vanishing. Living anchor lichen marks pieces safe to collect, preventing careless quarrying of the fixed coordinate. Price: 1-3 gp.",
      "name": "Nullstone"
    },
    "Fixed-Point Fragment": {
      "bonuses": [],
      "category": "Material",
      "description": "A needle of grey-violet crystal naturally shed when the Last Edge relieves spatial stress. Once lifted, it remains metaphysically tied to the exact formation point: teleportation leaves the fragment behind, and attempts to move it extradimensionally make it impossibly heavy. Planar artisans use that refusal as a reference when calibrating stable gates, never as a substitute for the Demi-Plane Anchor. Price: 2-5 gp.",
      "name": "Fixed-Point Fragment"
    },
    "Glow-Reed": {
      "bonuses": [],
      "category": "Material",
      "description": "A hollow Low Reaches reed with pale green-blue veins that fill with stored marsh light after sunset. Dried stalks remain flexible and glow when damp, lending themselves to lantern screens, baskets, breathing tubes, and alchemical wickwork. Cutting above the lowest joint lets the living root send up two new stems. Price: 10-25 cp per bundle.",
      "name": "Glow-Reed"
    },
    "Spirit Peat": {
      "bonuses": [],
      "category": "Material",
      "description": "Black-blue peat formed from old glow-reed, waterplant, and moss after the moving marsh completes a resting cycle. It burns with a clean turquoise flame hot enough for alchemical furnaces yet leaves mineral-rich ash that stabilizes spirit mixtures. Fresh peat must cure through one pool migration or its trapped mana spits unpredictably. Price: 15-35 cp per brick.",
      "name": "Spirit Peat"
    },
    "Luminous Waterplant": {
      "bonuses": [],
      "category": "Material",
      "description": "A soft aquatic plant with branching blue veins and clear leaves that fold around impurities. Placed in clean water, it absorbs weak toxins and excess ambient mana, brightening as it fills; a saturated plant must be composted in living marsh rather than eaten. Healers use carefully rinsed young leaves in salves and water-breathing preparations. Price: 20-50 cp.",
      "name": "Luminous Waterplant"
    },
    "Spirit Clay": {
      "bonuses": [],
      "category": "Material",
      "description": "Pearl-grey clay from Hollow Vale terrace banks, threaded with foxfire moss fibers finer than hair. It accepts runes, fingerprints, and brushwork with exceptional fidelity before firing, then develops a warm inner sheen where intent was repeated through actual craft. It is favored for talisman tablets and ritual vessels but does not enchant itself without skill and materials. Price: 25-60 cp per block.",
      "name": "Spirit Clay"
    },
    "Foxfire Moss": {
      "bonuses": [],
      "category": "Material",
      "description": "Soft sanctuary-and-vale moss bearing pinpricks of blue-violet foxfire between its leaves. It cushions impact, marks healthy root flow, and releases a clean cedar fragrance when disturbed; transplanted mats provide gentle light and help spirit-sensitive plants establish. Stripped of living substrate, it dims within days. Price: 20-50 cp per bundle.",
      "name": "Foxfire Moss"
    },
    "Mana Amber": {
      "bonuses": [],
      "category": "Material",
      "description": "Golden resin crystallized around ancient-looking prairie roots when the Deep Expanse stores more ambient mana than living tissue can safely hold. Inside each piece, a slow speck of light follows the original grain. Cut amber makes excellent enchantment cores and jewelry, while raw nodules can be replanted beside exhausted soil to release their charge gradually. Price: 3-8 sp.",
      "name": "Mana Amber"
    },
    "Warmroot": {
      "bonuses": [],
      "category": "Consumable",
      "description": "A rose-gold Southroll rhizome that stays pleasantly warm after harvest and smells of ginger, honey, and sun-dried grass. Roasted or brewed, it eases ordinary cold and fatigue and helps the body recover warmth after exposure without healing wounds by itself. Hill foxes replant overlooked pieces, so responsible harvesters deliberately leave the smallest roots behind. Price: 15-40 cp.",
      "name": "Warmroot"
    },
    "Firefly Dust": {
      "bonuses": [],
      "category": "Material",
      "description": "Gold dust naturally shed when Southroll fireflies complete one of their disciplined evening spirals. Each mote rises toward warmth and settles on moving air, giving ink, cosmetics, cloth, and festival lanterns a living shimmer that lasts several nights. Dust shaken from a captured firefly is dull; only freely shed material retains the pattern. Price: 25-60 cp per vial.",
      "name": "Firefly Dust"
    },
    "Rift Crystal": {
      "bonuses": [],
      "category": "Material",
      "description": "A black-blue crystal threaded with cold cobalt light, grown where stone pressure and unstable spatial mana meet safely in Rift March clefts. It stores earth or spatial energy densely but broadcasts strain as a delayed ringing through nearby rock. Master artisans value it for powerful devices; novices learn quickly why every piece needs a stable darkstone housing. Price: 5-15 sp.",
      "name": "Rift Crystal"
    },
    "Darkstone": {
      "bonuses": [],
      "category": "Material",
      "description": "Dense near-black Rift March rock whose fine grain drinks heat and resists fracture. Cold-light fungus traces natural fault lines across exposed blocks, showing where a clean quarry cut can be made without opening deeper clefts. Once worked, the stone holds fortifications and heavy enchantments with unshowy permanence. Price: 40-90 cp per workable block.",
      "name": "Darkstone"
    },
    "Blue Mana Ore": {
      "bonuses": [],
      "category": "Material",
      "description": "Metal-bearing ore crossed by vivid blue veins that brighten under hammer blows. Properly smelted with vent heat and darkstone flux, it yields a conductive alloy that carries mana without the brittleness of raw crystal; overheated ore vents its charge as harmless blue sparks but loses value. Echo bats often roost near the richest safe seams. Price: 2-6 sp per chunk.",
      "name": "Blue Mana Ore"
    },
    "Deep Fungus": {
      "bonuses": [],
      "category": "Material",
      "description": "A broad, dark cave fungus with cobalt gills, nourished by mineral seepage and the Rift March's cold light. It draws unstable trace mana from stone into chewy, bitter flesh that becomes safe once dried; alchemists use it in defensive tonics and mineral-restorative salves. A pale gill edge means the colony is still filtering and should not be harvested. Price: 20-50 cp.",
      "name": "Deep Fungus"
    },
    "Moon-Sand": {
      "bonuses": [],
      "category": "Material",
      "description": "Fine Quiet Shore sand that looks white by day and holds blue-violet constellations beneath moonlight or foxfire. Heated into glass, those points keep their arrangement, allowing artisans to make divination bowls, lunar lenses, and windows that show true reflected light without revealing anything outside their view. Loose sand flows uphill toward the not-water during false midnight. Price: 30-70 cp per pouch.",
      "name": "Moon-Sand"
    },
    "Shell Crystal": {
      "bonuses": [],
      "category": "Material",
      "description": "A pearlescent plate shed by a shellback skate beneath the Quiet Shore's not-water, found only after the boundary current places it above the tideline. It is light, hard, and disperses water magic in rippling rings across its surface. Polished pieces make elegant wet-safe fittings, armor inlay, and instruments whose tone carries cleanly through mist. Price: 1-3 sp.",
      "name": "Shell Crystal"
    },
    "Pale Driftwood": {
      "bonuses": [],
      "category": "Material",
      "description": "Smooth white wood condensed and accepted by the Quiet Shore from compatible organic patterns at the boundary. It is almost weightless, surprisingly tough, and drinks spirit enchantment along its pale grain without warping; when carved, the shavings curl into tiny tail shapes before becoming ordinary fiber. Each piece is inspected for ecological acceptance before removal. Price: 30-80 cp.",
      "name": "Pale Driftwood"
    },
    "Mana Fruit": {
      "bonuses": [
        {
          "type": "resource",
          "value": 5,
          "variable": "Mana"
        }
      ],
      "category": "Consumable",
      "description": "A Heartgate orchard fruit with pearl skin, violet veins, and flesh that shifts from pear-crisp to custard-soft around a seed glowing like banked foxfire. Eaten fresh, it restores 5 mana as its stored ambient charge disperses gently; overripe fruit is not stronger and belongs in the orchard soil, where brush-tail foxes bury the seeds. The flavor combines white peach, yuzu, and cool rain. Price: 30-60 cp.",
      "name": "Mana Fruit"
    },
    "Spirit Flower": {
      "bonuses": [],
      "category": "Material",
      "description": "A cultivated Heartgate bloom that opens to nearby living presence and closes tightly around hostility or disruptive magic without knowing anyone's thoughts. Each petal holds a trace of softened spirit energy suitable for medicines, incense, charms, and offerings; the center changes color with the Basin's current. Proper harvest takes alternating petals and leaves the flower able to seed. Price: 20-50 cp.",
      "name": "Spirit Flower"
    },
    "Redstone": {
      "bonuses": [],
      "category": "Material",
      "description": "Warm coral-red stone polished by Dawn Stream until thin gold lines appear beneath its surface. It stores gentle heat and converts moving water into a faint stable glow, making it excellent for bath channels, hearth plates, vitality enchantments, and paths visible beneath water. Dry redstone slowly cools and brightens again once returned to a current. Price: 30-70 cp per chunk.",
      "name": "Redstone"
    },
    "Clear Mana-Water": {
      "bonuses": [
        {
          "type": "resource",
          "value": 5,
          "variable": "Mana"
        }
      ],
      "category": "Consumable",
      "description": "Dawn Stream water sealed while flowing over living redstone, clear until shaken and then briefly filled with rose-gold light. Drinking a full vial restores 5 mana; it tastes of cold springwater and ripe plum, leaves no stimulant rush, and cannot be concentrated safely without losing its balance. Unsealed water returns to ordinary luminous streamwater within a day. Price: 25-50 cp.",
      "name": "Clear Mana-Water"
    },
    "Mana-Stone": {
      "bonuses": [],
      "category": "Material",
      "description": "Honey-grey Easthold rock dense with moderated heat and mana, warm along naturally occurring spiral seams. Set into a workshop or formation, it releases steady power through those seams; cracked across them, it flares wastefully and becomes inert. Gilt scarab trails reveal stones the upland has already loosened for safe collection. Price: 2-5 sp.",
      "name": "Mana-Stone"
    },
    "Heat Crystal": {
      "bonuses": [],
      "category": "Material",
      "description": "Amber-red crystal grown around an Easthold vent where ember-shrub roots have tempered the flow. It radiates reliable gentle heat without fuel, brightening when insulated and dimming in open cold; common uses include rooms, baths, incubation, food drying, and controlled forging. Immersion in Mirror Mere water safely discharges an overheated piece. Price: 3-8 sp.",
      "name": "Heat Crystal"
    },
    "Foxfire Bloom": {
      "bonuses": [],
      "category": "Material",
      "description": "A cobalt-violet sanctuary flower whose translucent petals cradle living foxfire without heat. At dusk its flame bends toward the shinboku root current and pollinating moths follow the motion; dried petals preserve that directional response for warding ink, spirit medicine, illusion craft, and shrine light. A bloom cut before pollination goes dark at once. Price: 40-90 cp.",
      "name": "Foxfire Bloom"
    },
    "Sacred Bamboo": {
      "bonuses": [],
      "category": "Material",
      "description": "Pale sanctuary bamboo with fine gold joints and a hollow core that carries breath, sound, and ward energy with exceptional clarity. Properly seasoned lengths become resilient bows, flutes, talisman cases, writing tools, and shrine frames; fresh cuts seal themselves with a bead of clear springwater. Harvest follows the grove's natural thinning and never requires clearing a stand. Price: 1-3 sp per usable length.",
      "name": "Sacred Bamboo"
    },
    "Spirit Wood": {
      "bonuses": [],
      "category": "Material",
      "description": "Naturally fallen foxwood, cedar, pine, or sakaki from the Veiled Fox Sanctuary, each pale grain containing hair-thin lines of ambient light. The wood conducts spirit magic smoothly and holds scent, music, and careful craftsmanship for decades, making it prized for staffs, instruments, shrines, and intimate furniture. Living trees reject forced cutting by turning the grain brittle and dark. Price: 3-8 sp.",
      "name": "Spirit Wood"
    },
    "Silver-Green Grass": {
      "bonuses": [],
      "category": "Material",
      "description": "Fine First Meadow grass whose silver face reflects moonlight while its green underside stores warmth. Braided fibers are strong, soft, and dimly luminous, suitable for bedding, cord, baskets, paper, and flexible charm frames. Cut after seeding, a bundle remains fragrant with clover and rain for a full season. Price: 10-25 cp per bundle.",
      "name": "Silver-Green Grass"
    },
    "Luminous Reed-Seed": {
      "bonuses": [],
      "category": "Material",
      "description": "A floating North Field seed with a warm point of light suspended in its translucent hull. It drifts along current mana-bearing air and water, so scattered seeds reveal circulation in paths, channels, and workshops before rooting in wet soil. Ground hulls support wind alchemy; viable seeds are reserved for restoration and cultivation. Price: 15-40 cp per pouch.",
      "name": "Luminous Reed-Seed"
    },
    "Mana-Rich Soil": {
      "bonuses": [],
      "category": "Material",
      "description": "Dark loam from naturally turned Threshold or Heartgate ground, marbled with pale root fiber and low, stable ambient mana. It accelerates healthy magical plants only when water, light, pollination, and care remain adequate; neglected soil grows luminous weeds rather than obedient crops. After several harvests it must rest beside living roots to recharge. Price: 20-50 cp per sack.",
      "name": "Mana-Rich Soil"
    },
    "Spirit Mineral": {
      "bonuses": [],
      "category": "Material",
      "description": "A family of Stone Rise minerals grown where springwater, lichen, and dense mana interact—some pearl, some cobalt, some rose-gold. Each specimen carries a different conductivity and must be identified through actual testing before enchanting or alchemy. The best pieces are those exposed by water and frost, not cut blindly from Foundation Ridge. Price: 1-3 sp per useful specimen.",
      "name": "Spirit Mineral"
    },
    "Mineral Water": {
      "bonuses": [],
      "category": "Consumable",
      "description": "Cold Stone Rise springwater carrying a stable trace of iron, pearl-shell mineral, and filtered ambient mana. It clears the palate, settles ordinary breathlessness, and provides an exceptionally neutral base for potions whose ingredients would react badly with common water. Its faint blue sheen disappears if contaminated. Price: 10-25 cp per flask.",
      "name": "Mineral Water"
    },
    "Spirit Pearl": {
      "bonuses": [],
      "category": "Material",
      "description": "A softly glowing pearl formed by Mirror Mere mussels as they layer nacre around excess ambient mana. The inner light turns slowly toward nearby water and can stabilize divination, water enchantment, memory-safe storage, and fine jewelry; it records no thoughts or secrets. Only pearls naturally released from mature mussels retain their calm glow. Price: 3-8 sp.",
      "name": "Spirit Pearl"
    },
    "Mirror-Lotus": {
      "bonuses": [],
      "category": "Material",
      "description": "A pale lavender lotus whose upper petals show the viewer with crystalline accuracy while the lower petals reflect the surrounding water. In ritual tea it sharpens recall of what the drinker actually witnessed, never inventing missing facts; in alchemy it stabilizes reflection and illusion effects. It blooms only where two honest physical reflections overlap on a calm pool. Price: 4-10 sp.",
      "name": "Mirror-Lotus"
    },
    "Frostwood": {
      "bonuses": [],
      "category": "Material",
      "description": "Pale fallen timber from Still Frontier conifers, cool even beside a forge and threaded with blue-white dormant foxfire. Containers made from it preserve temperature, while weapons and tools accept frost enchantments without becoming brittle. A living frostpine cut by force yields chalky useless wood; only naturally cast branches carry the stable grain. Price: 2-5 sp.",
      "name": "Frostwood"
    },
    "Ice Crystal": {
      "bonuses": [],
      "category": "Material",
      "description": "Clear supernatural ice found in root caves beneath Frostpine Ridge. It never melts under ordinary heat, but absorbs warmth until fine violet snow appears within; releasing the stored warmth requires a controlled mana pulse. Alchemists, healers, and builders use it for cold storage and frost craft, while careless users can still cause ordinary cold injury. Price: 3-8 sp.",
      "name": "Ice Crystal"
    },
    "Silver Lichen": {
      "bonuses": [],
      "category": "Material",
      "description": "Constellation-bright lichen spread across Pale Reaches stone, each colony mapping local moisture and potential density in changing points of silver. Dried flakes become navigation ink and sensitive alchemical powder that brightens near raw dimensional mist; they do not predict events or reveal distant places. Harvesters take one edge and leave the colony's dark center intact. Price: 25-60 cp.",
      "name": "Silver Lichen"
    },
    "Pale Crystal": {
      "bonuses": [],
      "category": "Material",
      "description": "Milky crystal condensed beneath a Ghost Valley where lichen has already filtered raw potential. Its interior remains nearly blank, accepting a carefully designed enchantment with unusual fidelity but amplifying sloppy structure just as faithfully. Artisans value it as a magical canvas, not as a source of free power. Price: 1-4 sp.",
      "name": "Pale Crystal"
    },
    "Rivergrass": {
      "bonuses": [],
      "category": "Material",
      "description": "Tough blue-green North Field grass with ribbon-flat blades and roots that release rather than tear when a channel relocates. Dried fibers make water-resistant rope, baskets, mats, and bandaging; fresh pith carries a mild clean bitterness used in wetland medicine. Braids tighten when wet and relax without damage when dry. Price: 10-20 cp per bundle.",
      "name": "Rivergrass"
    },
    "Mana-Rich Silt": {
      "bonuses": [],
      "category": "Material",
      "description": "Fine blue-grey sediment left when a Shining Channel migrates, speckled with empty reed-seed hull and ribbonfin scale. It nurtures aquatic and wetland plants while slowly releasing mana instead of forcing sudden growth. A sack spread on dry soil is wasted; it remains fertile only when kept damp and biologically active. Price: 20-50 cp per sack.",
      "name": "Mana-Rich Silt"
    },
    "Warped Stone": {
      "bonuses": [],
      "category": "Material",
      "description": "Fold stone whose inner angles do not agree with its visible outline. A palm-sized piece can contain a longer carved channel than its surface permits, useful for puzzle locks, compact conduits, and spatial study; careless chiseling may make the tool emerge from the wrong face. Copper foxfire along a natural crease marks the safest cutting line. Price: 3-8 sp.",
      "name": "Warped Stone"
    },
    "Spatial Crystal": {
      "bonuses": [],
      "category": "Material",
      "description": "A rare transparent Fold crystal that bends light, reach, and apparent distance around its edges. Properly mounted, it supports high-level teleportation calibration, extradimensional storage, and precise spatial enchantments; unmounted shards make nearby objects seem nearer without actually moving them. It cannot bypass the Demi-Plane's access rules or locate unknown destinations. Price: 1-3 gp.",
      "name": "Spatial Crystal"
    },
    "Foldglass": {
      "bonuses": [],
      "category": "Material",
      "description": "Thin glass-like mineral formed when two Fold slopes touch and separate, preserving a view from each face to the other. Rotating a pane changes which physically connected surface it shows, making it valuable for lenses, maps, inspection tools, and intricate illusion devices. It never displays a place with which the pane has not shared a fold. Price: 5-15 sp.",
      "name": "Foldglass"
    },
    "Veilglass": {
      "bonuses": [],
      "category": "Material",
      "description": "Nearly transparent crystal shed from the Veiled Edge after a stable aurora pulse. It transmits spirit and boundary light while blocking loose dimensional residue, making it suited to portal windows, ward housings, and planar observation instruments. Through it, distant layers remain visible but no closer or more accessible. Price: 8-20 sp.",
      "name": "Veilglass"
    },
    "Aurora Crystal": {
      "bonuses": [],
      "category": "Material",
      "description": "A cool crystal containing slow ribbons of emerald, rose, cobalt, and gold boundary light. A mana pulse releases one ribbon as room-filling radiance before it gradually returns to the crystal, and the color depends on which facet is touched. Illusionists, lampmakers, and spirit artisans value its clean reusable spectrum. Price: 5-12 sp.",
      "name": "Aurora Crystal"
    },
    "Silver Spirit-Grass": {
      "bonuses": [],
      "category": "Material",
      "description": "Fine silver grass from the inner Veiled Edge, each blade rippling toward spatial disturbance even in still air. Braided into a tassel, it becomes a durable boundary indicator for laboratories and warded doors; it shows direction and intensity only. Fallen mature blades retain the response, so uprooting living clumps is unnecessary. Price: 30-80 cp per bundle.",
      "name": "Silver Spirit-Grass"
    },
    "Boundary Essence": {
      "bonuses": [],
      "category": "Material",
      "description": "A rare opaline droplet shed inward when the Shimmering Curtain completes a stable ripple. Suspended in veilglass, it can anchor one demanding portal, summoning, or dimensional enchantment during construction, after which the essence becomes clear inert glass. Harvesting an attached droplet is dangerous to the curtain; naturally fallen essence is both safer and stronger. Price: 1-3 gp.",
      "name": "Boundary Essence"
    },
    "Jade Rite Coin": {
      "name": "Jade Rite Coin",
      "description": "A ceremonial disc of dark green jade veined with warm foxfire-gold, minted for the established rites of the Kitsune no Kage and marked with the Mother Fox's household crest. It is a token of recognized estate authority, obligation, or completed observance—not ordinary spending money, universal sanctuary access, or proof of Tsukiko's personal favor. Held under moonlight, the engraved tail briefly appears to move around the rim.",
      "category": "Currency",
      "bonuses": []
    },
    "Shinboku Leaf-Silver": {
      "name": "Shinboku Leaf-Silver",
      "category": "Material",
      "bonuses": [],
      "description": "One of the nine light-leaves the sanctuary's shinboku releases at false dawn, caught only after it dissolves into a paper-thin silver flake above the moss. A flake carries softened root-current for a season and can steady a spirit ward, sanctify ink, or mend a cracked charm without granting any part of Tsukiko's divinity. The living tree cannot be forced to yield it. Price: 1-3 gp if Tsukiko permits it to leave the estate."
    },
    "Violetwing Glass": {
      "name": "Violetwing Glass",
      "category": "Material",
      "bonuses": [],
      "description": "A translucent scale naturally shed by a sanctuary violetwing moth, clear until foxfire reveals branching violet veins. Set into a lantern or lens, it filters harsh magical light into a spectrum safe for spirit-sensitive eyes and plants. A complete handful is collected over weeks beneath pollination roosts. Price: 2-6 sp per small packet."
    },
    "Dusk Honey": {
      "name": "Dusk Honey",
      "category": "Consumable",
      "bonuses": [],
      "description": "First Meadow honey stored by duskbees in comb as clear as amber glass, tasting of moonlace, clover, and cool rain. A spoonful settles ordinary nerves and produces vivid color-rich sleep without prophecy, compulsion, or emotional erasure; heated too strongly, it becomes ordinary fragrant sugar. Price: 40-90 cp per sealed comb."
    },
    "Foxfire Clover Seed": {
      "name": "Foxfire Clover Seed",
      "category": "Material",
      "bonuses": [],
      "description": "Tiny black seeds marked by one cobalt spark, harvested from Heartgate and Westreach ground after the clover finishes protecting bare soil. Sown over mana-scorched earth, they germinate into a low cover that absorbs weak residue and turns it into fertile loam; healthy clover goes dark when the soil is safe. It cannot cleanse curses or major contamination by itself. Price: 1-3 sp per planting pouch."
    },
    "Rootstream Ink": {
      "name": "Rootstream Ink",
      "category": "Tool",
      "bonuses": [],
      "description": "A diagnostic ink brewed from spirit pollen, mineral water, and one drop of lantern-tree sap. Painted on stone, wood, or parchment, it changes from pearl to violet, cobalt, or gold in the presence of nearby flowing mana and shows direction through the movement of its sheen. The ink reveals present flow only—not hidden identities, distant events, or causes—and fades after one day. Price: 4-10 sp per inkwell."
    },
    "Foxpath Compass": {
      "name": "Foxpath Compass",
      "category": "Tool",
      "bonuses": [],
      "description": "A palm-sized spirit-wood disc holding nine loose silver needles around a bead of foxfire dew. Inside the Demi-Plane, one needle points toward a marked location the bearer has personally visited and consciously selects; outside it, every needle rests. The compass cannot find secrets, unknown places, people, or a route forbidden by Tsukiko's wards. Price: 8-20 sp, normally made only for permitted residents or guests."
    },
    "Hearthspring Mineral Salt": {
      "name": "Hearthspring Mineral Salt",
      "category": "Consumable",
      "bonuses": [],
      "description": "Pearl, violet, and gold crystals skimmed from Hearth Springs overflow after steam orchids have flowered. Dissolved into hot water, a packet recreates the spring's cedar-sweet vapor and eases ordinary fatigue, muscle ache, and chill over a long soak without healing wounds or replacing rest. The colors fade in order as the salt is spent. Price: 30-80 cp per bathing packet."
    },
    "Spring-Snail Pearl Shell": {
      "name": "Spring-Snail Pearl Shell",
      "category": "Material",
      "bonuses": [],
      "description": "An empty translucent shell left by a Stone Rise spring-snail after it outgrows its spiral home. The shell contains concentric traces of every mineral current the animal crossed; potion makers use powdered outer whorls to keep reactive ingredients separated until brewing is complete. Held to the ear, it hums at the pitch of the spring it came from. Price: 2-5 sp."
    },
    "Mirrorfin Scale": {
      "name": "Mirrorfin Scale",
      "category": "Material",
      "bonuses": [],
      "description": "A thin silver-lilac scale shed at Mirror Mere spawning beds. Its two faces retain different images for several minutes—the water below and the sky above—allowing careful alchemists to stabilize dual-state illusions and memory-safe recording charms. It reflects only what physically reached it. Price: 1-4 sp."
    },
    "Twilight Memory Vial": {
      "name": "Twilight Memory Vial",
      "category": "Tool",
      "bonuses": [],
      "description": "A veilglass vial lined with Mirrorfin scale and filled with one finger of Twilight Pool water. Opened beside a calm reflection, it stores a single silent visual moment for up to one day and replays it once across the water's surface before becoming clear. It captures no thoughts, hidden details, sound, or events outside the reflected view. Price: 12-30 sp."
    },
    "Dawncrane Glass Feather": {
      "name": "Dawncrane Glass Feather",
      "category": "Material",
      "bonuses": [],
      "description": "A clear feather naturally cast by a Dawn Barrow crane, its edge tinted rose by years of flying above redstone water. It flexes like keratin but conducts water and light magic like glass, making a superb calligraphy nib, current sensor, or inlay for graceful movement enchantments. The feather glows when pointed downstream. Price: 3-8 sp."
    },
    "Ember-Shrub Wax": {
      "name": "Ember-Shrub Wax",
      "category": "Material",
      "bonuses": [],
      "description": "A warm golden wax secreted around mature Easthold seedpods to keep concentrated heat from scorching the embryo. It melts only when deliberately worked, seals containers against temperature change, and burns with a smokeless low flame after the seed is removed. Gilt scarabs spread the seeds, so pods are harvested only after their exit holes appear. Price: 1-3 sp per block."
    },
    "Glasswing Honey": {
      "name": "Glasswing Honey",
      "category": "Consumable",
      "bonuses": [
        {
          "type": "resource",
          "value": 5,
          "variable": "Stamina"
        }
      ],
      "description": "Rose-gold Southroll honey made by glasswing bees from warmroot and golden herb flowers. One spoon restores 5 stamina and leaves the eater comfortably warm, with a flavor of ginger blossom and browned sugar; further spoonfuls are food, not stacking miracles. The transparent comb throws tiny sunset colors across the jar. Price: 1-3 sp per sealed comb."
    },
    "Dream-Salamander Sheath": {
      "name": "Dream-Salamander Sheath",
      "category": "Material",
      "bonuses": [],
      "description": "A complete translucent skin shed by a Low Reaches dream-salamander when its nursery pool migrates. The sheath carries green-blue patterns that shift toward clean water and curl away from common toxins, making it useful for filters, marsh masks, and alchemical testing. It does not detect curses or unknown substances outside its natural range. Price: 2-6 sp."
    },
    "Grasswhale Song Amber": {
      "name": "Grasswhale Song Amber",
      "category": "Accessory",
      "bonuses": [],
      "description": "A thumb-sized piece of Deep Expanse mana amber formed around a hollow root that once carried a grasswhale's infrasonic call. Worn against the body, it vibrates when a large herd or grasswhale moves through the surrounding prairie, giving warning through rhythm rather than direction or identity. Away from the Expanse it is simply warm, beautiful amber. Price: 8-20 sp."
    },
    "Fold-Knot Cord": {
      "name": "Fold-Knot Cord",
      "category": "Tool",
      "bonuses": [],
      "description": "Silver-green grass cord braided around one filament of silence-thread fungus and knotted at a known point in the Fold. While the local geometry remains stable, its loose end consistently falls toward that knot, offering one reliable return route; after guiding a traveler out, the spatial tension frays the cord into ordinary fiber. It cannot cross wards, realms, or an unknown fold. Price: 5-12 sp."
    },
    "Pearl-Moth Silk": {
      "name": "Pearl-Moth Silk",
      "category": "Material",
      "bonuses": [],
      "description": "Nearly invisible silk gathered from empty cocoons along the Fade's solid slopes. Woven fabric loses saturation toward its edges and breaks up the wearer's outline in mist without making them invisible; under direct light it shines like mother-of-pearl. The silk unravels if carried beyond stable ground before being spun. Price: 5-15 sp per usable skein."
    },
    "Anchor-Lichen Seal": {
      "name": "Anchor-Lichen Seal",
      "category": "Accessory",
      "bonuses": [],
      "description": "A small anchor-stone clasp cushioned with living Grey Boundary lichen. Fastened to a chest, pack, or instrument, its pale curl stains wine-red if the object is displaced by teleportation or spatial magic while sealed, providing evidence of movement without preventing it. The lichen must be misted monthly to remain responsive. Price: 10-25 sp."
    },
    "Sentinel-Moth Dust": {
      "name": "Sentinel-Moth Dust",
      "category": "Material",
      "bonuses": [],
      "description": "Silver dust left on the Last Edge only after rare sentinel moths emerge during anchor strain. Mixed into rootstream ink, it makes a line react specifically to spatial drift for one week; alone it is inert and cannot create or repair an anchor. Collecting it is safe only after every moth has departed. Price: 1-3 gp due to rarity."
    },
    "Boundary Dew Ampoule": {
      "name": "Boundary Dew Ampoule",
      "category": "Consumable",
      "bonuses": [],
      "description": "A single opaline drop condensed where Quiet Shore not-water becomes buried freshwater, sealed in shell crystal. Poured across a surface, it runs toward the nearest active spatial pressure and evaporates after tracing one pale line; planar artisans use it to inspect seams before work. It cannot locate portals at long range or open any boundary. Price: 6-15 sp."
    },
    "Ninefold Orchard Preserve": {
      "name": "Ninefold Orchard Preserve",
      "category": "Consumable",
      "bonuses": [
        {
          "type": "resource",
          "value": 5,
          "variable": "Mana"
        }
      ],
      "description": "Heartgate mana fruit simmered with Dusk Honey and sealed under lantern-tree lacquer, the preserve holding violet, gold, and pearl ribbons in a dark glass jar. One serving restores 5 mana with the same gentle charge as fresh fruit and tastes of white peach, yuzu, cedar, and honey; extra servings remain excellent food without multiplying the immediate effect. Price: 1-3 sp per small jar."
    },
    "Dawnfield Softfur": {
      "name": "Dawnfield Softfur",
      "category": "Material",
      "description": "A palmful of pale-gold underfur shed by Dawnfield Hares in spring or recovered from a hunted animal. It stays warm while remaining exceptionally light, making it useful for glove linings, infant blankets, spell-pouches, and wind-sensitive fletching. Price: 10–25 cp per cleaned tuft.",
      "bonuses": []
    },
    "Grainback Tusk": {
      "name": "Grainback Tusk",
      "category": "Material",
      "description": "A cream-colored tusk from a mature Grainback Boar, marked by fine gold growth rings produced by mana-rich grain. Ground tusk reinforces stamina tonics; whole curves become durable knife handles, agricultural charms, and horn bows. Price: 30–80 cp each.",
      "bonuses": []
    },
    "Riverglass Pelt": {
      "name": "Riverglass Pelt",
      "category": "Material",
      "description": "The water-shedding outer pelt of a Riverglass Otter, legally traded from managed hunts or collected as molted guard-hair felt. Properly cured material remains dry after immersion and is prized for gloves, satchels, fishing gear, and water-resistant spellbook covers. Price: 1–3 sp.",
      "bonuses": []
    },
    "Suncrest Spur": {
      "name": "Suncrest Spur",
      "category": "Material",
      "description": "A hollow copper-red heel spur from a Suncrest Cockatrice. The dried venom inside causes brief muscular rigidity and is used in measured paralytic antidote research, trap coatings, and stiffness curses; careless handling can numb an entire hand. Price: 2–6 sp.",
      "bonuses": []
    },
    "Grifonmere Serpent Scale": {
      "name": "Grifonmere Serpent Scale",
      "category": "Material",
      "description": "A hand-sized silver-blue scale shed during a Grifonmere Lake Serpent's seasonal molt. Its overlapping grain disperses water pressure and cold, making it valuable for lake armor, diving wards, shields, and durable fishing blades. Price: 6–15 sp per intact scale.",
      "bonuses": []
    },
    "Pale Charger Mane": {
      "name": "Pale Charger Mane",
      "category": "Material",
      "description": "Long silver-white mane hair gathered from natural snag sites or grooming a bonded Pale Steppe Charger. Braided fibers remain strong under sweat and rain and are used for reins, bowstrings, weather charms, and prestigious horse-clan cords. Price: 40–90 cp per braid.",
      "bonuses": []
    },
    "Orehide Horn Core": {
      "name": "Orehide Horn Core",
      "category": "Material",
      "description": "The dense inner core of a naturally shed Orehide Ram horn, streaked with whichever metals dominated its range. Smiths grind it into flux or carve it into prospecting handles that grow faintly warm near matching ore. Price: 1–4 sp.",
      "bonuses": []
    },
    "Furnace Salamander Gland": {
      "name": "Furnace Salamander Gland",
      "category": "Material",
      "description": "A heat-storing throat gland harvested from a dead Furnace Salamander or collected after rare natural shedding. Sealed in ceramic, it warms a small container for days; alchemists use its oil in fire-resistance salves and reliable ignition paste. Price: 2–5 sp.",
      "bonuses": []
    },
    "Frostvein Roc Pinion": {
      "name": "Frostvein Roc Pinion",
      "category": "Material",
      "description": "A broad slate-blue flight feather from a Frostvein Roc, usually recovered below a molt site rather than taken from a living bird. It stays rigid in sleet and channels cold air cleanly, suiting heavy arrows, wind fans, and mountain-weather instruments. Price: 8–20 sp.",
      "bonuses": []
    },
    "Magma Burrower Plate": {
      "name": "Magma Burrower Plate",
      "category": "Material",
      "description": "A dark hexagonal armor plate cast from a Magma Burrower's body as it grows. It tolerates extreme heat and slowly releases stored warmth, making it valuable for forge shields, furnace doors, heated armor layers, and geothermal construction. Price: 10–30 sp.",
      "bonuses": []
    },
    "Deepstone Basilisk Lens": {
      "name": "Deepstone Basilisk Lens",
      "category": "Material",
      "description": "A dark translucent eye-lens from a slain Deepstone Basilisk, clouded with branching mineral veins. Properly stabilized, it supports petrification wards, stone-shaping tools, and antidotes to progressive mineralization; untreated lenses remain dangerous to handle. Price: 2–6 gp.",
      "bonuses": []
    },
    "Warden Gearheart": {
      "name": "Warden Gearheart",
      "category": "Material",
      "description": "The interlocked rune-drive at the center of a disabled Khad Varr Gear Warden. When intact it supplies measured motive force to constructs, lifts, locks, and workshop machinery; damaged hearts stutter violently and require a master artificer. Price: 3–10 gp.",
      "bonuses": []
    },
    "Lantern Toad Glow-Sac": {
      "name": "Lantern Toad Glow-Sac",
      "category": "Material",
      "description": "A translucent throat membrane naturally shed in fragments as a Lantern Toad matures, or harvested intact from a dead specimen. Treated with salt and glycerin, it becomes a soft lamp bladder that glows when flexed and is useful in fog lanterns and alchemical indicators. Price: 20–60 cp.",
      "bonuses": []
    },
    "Mirejaw Scute": {
      "name": "Mirejaw Scute",
      "category": "Material",
      "description": "A ridged black-green back plate from a Mirejaw Crocodile. Properly boiled and scraped, it becomes tough water-resistant armor material; powdered outer keratin thickens marsh salves and waterproofing compounds. Price: 1–4 sp.",
      "bonuses": []
    },
    "Corpse-Reed Anticoagulant": {
      "name": "Corpse-Reed Anticoagulant",
      "category": "Material",
      "description": "A sealed vial of clear enzyme taken from a Corpse-Reed Leech's feeding sac. Healers use minute doses to prevent dangerous clotting and alchemists use it in blood-working preparations; an overdose causes prolonged bleeding. Price: 50–120 cp per vial.",
      "bonuses": []
    },
    "Fen Widow Silk": {
      "name": "Fen Widow Silk",
      "category": "Material",
      "description": "Grey-green silk reeled from an abandoned Fen Widow web after the spider moves on or from a cleared nest. It remains adhesive when wet and is prized for marsh rope, wound closure, trapcraft, and waterproof textile reinforcement. Price: 2–7 sp per usable skein.",
      "bonuses": []
    },
    "Bog Wyrm Bile-Stone": {
      "name": "Bog Wyrm Bile-Stone",
      "category": "Material",
      "description": "A green-black mineral concretion formed inside a mature Bog Wyrm as it neutralizes toxic marsh mana. Refined fragments strengthen poison antidotes, acid-resistant coatings, and wetland purification charms. Price: 10–25 sp.",
      "bonuses": []
    },
    "Wisp Heron Plume": {
      "name": "Wisp Heron Plume",
      "category": "Material",
      "description": "A smoke-grey plume naturally shed by a Wisp Heron, its tip holding a small green reflection that points toward nearby free-floating light. Used in fog compasses, witch lanterns, fishing charms, and delicate illusion brushes. Price: 60–150 cp.",
      "bonuses": []
    },
    "Silverhorn Cast Antler": {
      "name": "Silverhorn Cast Antler",
      "category": "Material",
      "description": "A naturally shed antler from a Silverhorn Hart, pale as moonlit bark and threaded with living moss. It conducts gentle nature magic and is carved into healing foci, bows, ritual handles, and Warden tokens. Price: 2–6 sp.",
      "bonuses": []
    },
    "Thornback Quill": {
      "name": "Thornback Quill",
      "category": "Material",
      "description": "A leaf-shaped keratin quill shed from a Thornback Lynx's shoulder mantle. It holds poison, dye, or spell-ink without absorbing it and makes excellent darts, needles, engraving points, and nature-alchemy stirrers. Price: 40–100 cp each.",
      "bonuses": []
    },
    "Moonpetal Wingdust": {
      "name": "Moonpetal Wingdust",
      "category": "Material",
      "description": "Fine silver dust gathered beneath a completed Moonpetal Moth emergence. It causes night-blooming plants to open and gives ink or cosmetics a cool lunar sheen; concentrated dust supports sleep remedies and moonlight illusions. Price: 30–90 cp per vial.",
      "bonuses": []
    },
    "Rootcoil Scent Gland": {
      "name": "Rootcoil Scent Gland",
      "category": "Material",
      "description": "A knotted musk gland from a mature Rootcoil Serpent, carrying the scent pattern of living elder roots. Diluted oil calms many burrowing forest beasts and helps Wardens mask fresh pruning from pests; concentrated oil causes heavy drowsiness. Price: 4–10 sp.",
      "bonuses": []
    },
    "Barkmantle Moss-Hide": {
      "name": "Barkmantle Moss-Hide",
      "category": "Material",
      "description": "A section of naturally sloughed mossy hide or carefully cured pelt from a dead Barkmantle Bear. The living moss layer insulates, slowly closes small cuts in leather, and supports camouflage in woodland when kept damp. Price: 12–30 sp.",
      "bonuses": []
    },
    "Whisperwing Flight Feather": {
      "name": "Whisperwing Flight Feather",
      "category": "Material",
      "description": "A broad pale feather shed by a Whisperwing Owl, with a serrated edge that disperses air vibration. It is prized for silent fletching, acoustic wards, recording rooms, and fans that move air with almost no noise. Price: 2–5 sp.",
      "bonuses": []
    },
    "Tideglass Carapace": {
      "name": "Tideglass Carapace",
      "category": "Material",
      "description": "A translucent shell cast during a Tideglass Crab's molt. It is light, waterproof, and breaks light into aquatic colors, making it useful for jewelry, potion windows, signal mirrors, and decorative armor inlay. Price: 20–70 cp.",
      "bonuses": []
    },
    "Reefback Coral Plate": {
      "name": "Reefback Coral Plate",
      "category": "Material",
      "description": "A naturally detached piece of coral-sheathed scute from a Reefback Turtle. The living coral accepts water enchantments and can be maintained in a saltwater setting for filtration, reef restoration, or shield inlay. Price: 2–6 sp.",
      "bonuses": []
    },
    "Brinecoil Capacitor Organ": {
      "name": "Brinecoil Capacitor Organ",
      "category": "Material",
      "description": "A layered electric organ from a Brinecoil Eel, preserved in brine immediately after harvest. It stores a modest magical or electrical charge for tools, traps, medical stimulation, and storm research; overfilling ruptures it. Price: 4–12 sp.",
      "bonuses": []
    },
    "Stormray Sail": {
      "name": "Stormray Sail",
      "category": "Material",
      "description": "A flexible strip of wing membrane naturally shed along a Stormray's trailing edge. It stiffens under electrical charge and channels wind cleanly, suiting storm cloaks, glider vanes, lightning rods, and weather instruments. Price: 8–20 sp.",
      "bonuses": []
    },
    "Mimic Coral Nodule": {
      "name": "Mimic Coral Nodule",
      "category": "Material",
      "description": "A fist-sized living nodule cut from a disabled Coral Mimic and rendered dormant in treated salt. Alchemists use its adaptive pigment in camouflage dyes and its regenerative lattice in coral repair; improper storage lets the feeding pores reopen. Price: 5–15 sp.",
      "bonuses": []
    },
    "Deepwake Pressure Plate": {
