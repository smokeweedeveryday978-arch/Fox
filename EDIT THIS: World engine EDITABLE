    "The Whispering Maze": {
      "complexityType": "wilderness",
      "detailType": "basic",
      "name": "The Whispering Maze",
      "radius": 5,
      "region": "Caelvir",
      "x": 5,
      "y": 25,
      "basicInfo": "A living labyrinth formed by a grove of trees that have grown into an interconnected, self-repairing maze of trunks, branches, and root-walls. The Maze shifts slowly — paths that existed yesterday may close today, and new passages open without warning. Something in the center calls to those with magical sensitivity, and the Maze itself seems to test visitors: the cruel get lost, the respectful find the way. It is classified as a B-rank dungeon by the Guild, but the real danger is psychological — the Maze whispers your insecurities as you walk.",
      "hiddenInfo": "The Maze is the forest's immune system made visible. It was grown deliberately to contain a pre-Collapse artifact that the Elders deemed too dangerous to destroy and too powerful to leave unguarded. The thing in the center is not calling — it is screaming.",
      "factions": [],
