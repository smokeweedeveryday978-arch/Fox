      "category": "Accessory",
      "description": "A blacksteel throat-guard that buckles beneath the helm. Small, unloved, and the one piece veterans never leave off. Price: 1-3 sp.",
      "name": "Blacksteel Gorget"
    },
    "Blacksteel Pauldrons": {
